# Every environment variable this project uses, with dummy values. Copy to
# .env (gitignored) and fill in real values there; never in this file.
# docs/configuration.md says what each one does. Empty or commented-out
# values use the default.

# --- Library ---------------------------------------------------------------

# The library's catalog feed: /api/v1/catalog on the library app.
LIBRARY_CATALOG_URL=https://library.example.com/api/v1/catalog

# API key for the feed. An admin creates one under Settings -> API keys in
# the library app; it's shown once, when it's created.
LIBRARY_API_KEY=lib_REPLACE_ME

# Timeout for catalog requests, in seconds.
# REQUEST_TIMEOUT_SECONDS=60

# --- Qdrant ----------------------------------------------------------------

# The compose files point this at their own qdrant service.
QDRANT_URL=http://qdrant:6333
# Only if your Qdrant requires an API key.
# QDRANT_API_KEY=REPLACE_ME
# QDRANT_COLLECTION=library
# cosine, dot, euclid or manhattan; only used when creating the collection.
# QDRANT_DISTANCE=cosine

# --- Embeddings ------------------------------------------------------------

# Model the OpenAI-compatible API at OPENAI_BASE_URL serves. The default is
# ModernBERT Embed from Hugging Face (768 dimensions), e.g. served by
#   docker run -p 8080:80 ghcr.io/huggingface/text-embeddings-inference:cpu-latest --model-id nomic-ai/modernbert-embed-base
# Changing it changes the vector size: use a new QDRANT_COLLECTION.
# EMBEDDING_MODEL=nomic-ai/modernbert-embed-base

# Texts per embedding request.
# EMBEDDING_BATCH_SIZE=32

# The model's token limit; longer texts are truncated, prefix included.
# EMBEDDING_CONTEXT_LENGTH=512

# Prompt prefixes the model was trained with: one on search queries, one on
# the books being searched. A space is added after each; write \n for a
# newline and none for no prefix (empty means the ModernBERT default).
# Changing the document prefix re-embeds every book on the next sync.
# Anything else that searches the collection must add the query prefix.
#
#   Model                          Query prefix              Document prefix
#   nomic-ai/modernbert-embed-*,   search_query:             search_document:
#     nomic-embed-text
#   e5 family                      query:                    passage:
#   mxbai-embed-large              Represent this sentence   none
#                                  for searching relevant
#                                  passages:
#   OpenAI text-embedding-3-*      none                      none
EMBEDDING_QUERY_PREFIX=search_query:
EMBEDDING_DOCUMENT_PREFIX=search_document:

# OpenAI-compatible API base URL. From inside Docker, a server on the Docker
# host is http://host.docker.internal:8080/v1 (Ollama: port 11434). For
# OpenAI itself, https://api.openai.com/v1.
OPENAI_BASE_URL=http://host.docker.internal:8080/v1

# Sent as a bearer token. Usually unneeded for a local server; required for
# api.openai.com.
# OPENAI_API_KEY=REPLACE_ME

# --- Scheduling ------------------------------------------------------------

# Seconds between syncs; 0 syncs once and exits.
# POLL_INTERVAL_SECONDS=3600

# Re-embed every book on the first sync after starting.
# FORCE_REINGEST=false

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO

# --- Compose (not read by the app) -----------------------------------------

# Release to run with docker-compose.prod.yaml.
# APP_VERSION=latest

# --- Publishing to PyPI (optional; not read by the app) --------------------
# Only for publishing by hand from your machine (`uv publish`); releases
# from GitHub use trusted publishing or the PYPI_API_TOKEN repository
# secret instead; see
# https://github.com/romkey/python-ai-rules/blob/main/docs/releasing.md
# A project-scoped API token from https://pypi.org/manage/account/token/. Keep it out of
# .env on servers: compose passes .env to the app.
# UV_PUBLISH_TOKEN=pypi-REPLACE_ME
